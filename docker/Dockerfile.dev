# Host image for tests and `build.sh native` only. Device binaries are built in
# Dockerfile.toolchain against the LoveRetro sysroots, whose glibc sets their
# symbol ceiling (enforced by build.sh) — so this image's Debian release does
# not affect what ships. It used to be bullseye for that reason, from before
# the toolchain images existed; bullseye's archive has since been retired.
FROM golang:1.27-bookworm
ENV GOTOOLCHAIN=local
RUN dpkg --add-architecture arm64 && \
    apt-get update && apt-get install -y \
    libsdl2-dev libsdl2-ttf-dev libsdl2-image-dev \
    libsdl2-dev:arm64 libsdl2-ttf-dev:arm64 \
    gcc-aarch64-linux-gnu \
    zip bsdmainutils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
